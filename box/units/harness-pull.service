[Unit]
Description=Deploy hermes-harness master to the box

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'cd %h/TIG/hermes-harness && git fetch -q origin && want=$(git rev-parse origin/master) && stamp=%h/.local/share/harness-deployed.sha && { [ "$(cat "$stamp" 2>/dev/null)" = "$want" ] || { git checkout -q master && git reset -q --hard origin/master && box/install.sh && mkdir -p "$(dirname "$stamp")" && printf %s "$want" > "$stamp"; }; }'
