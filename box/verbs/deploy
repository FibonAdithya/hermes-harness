#!/usr/bin/env python3
"""Deploy hermes-harness master onto the box. Gated on the broker side.

harness-pull.service is a oneshot (git reset to origin/master, then install.sh),
so `systemctl --user start` blocks until it finishes and fails if it did.
"""
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import boxlib  # noqa: E402

boxlib.read_json_stdin(sys.stdin.buffer)
r = subprocess.run(["systemctl", "--user", "start", "harness-pull.service"],
                   capture_output=True, text=True, check=False)
if r.returncode != 0:
    sys.exit(boxlib.refuse(f"deploy failed: {(r.stderr or '').strip()[:300]}"))
print(json.dumps({"deployed": True}))
