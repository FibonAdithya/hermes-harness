#!/usr/bin/env python3
"""The commits the box last deployed for each target. Ungated, read-only."""
import json
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import boxlib  # noqa: E402

SHA_RE = re.compile(r"[0-9a-f]{40}")


def stamp(name: str):
    path = Path(os.environ["HOME"]) / ".local/share" / name
    try:
        text = path.read_text().strip()
    except OSError:
        return None
    return text if SHA_RE.fullmatch(text) else None


boxlib.read_json_stdin(sys.stdin.buffer)
print(json.dumps({"harness": stamp("harness-deployed.sha"), "fleet": stamp("fleet-deployed.sha")}))
