#!/usr/bin/env python3
"""The owner's `answer` reply: record it for fleet and send the issue back to ready. Called only by the broker's approvals listener."""
import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import boxlib  # noqa: E402
import tasklib  # noqa: E402

a = boxlib.read_json_stdin(sys.stdin.buffer) or {}
home = Path(os.environ.get("HOME", "/home/adi"))
try:
    repo = tasklib.repo_dir(home, a.get("repo", ""))
    slug = tasklib.slug(repo)
    number, want_hash, text = a.get("number"), a.get("hash"), a.get("text")
    if type(number) is not int or number < 1:
        sys.exit(boxlib.refuse("number must be a positive integer"))
    if not isinstance(want_hash, str) or not isinstance(text, str):
        sys.exit(boxlib.refuse("hash and text must be strings"))
    out = tasklib.answer(tasklib.real_gh, slug, number, want_hash, text, home, time.time())
except (ValueError, TypeError) as exc:
    sys.exit(boxlib.refuse(str(exc)))
print(json.dumps({"repo": repo.name, "slug": slug, **out}))
