#!/usr/bin/env python3
"""Run one Claude Code task in the executor container, PR only. Gated on the broker side.

The id is minted before the prompt is written, because the prompt must be on
disk before the unit starts; start_night is then given that id.
"""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import boxlib  # noqa: E402

a = boxlib.read_json_stdin(sys.stdin.buffer) or {}
home = Path(os.environ.get("HOME", "/home/adi"))
prompt = a.get("prompt", "")
if not isinstance(prompt, str) or not prompt.strip():
    sys.exit(boxlib.refuse("prompt is required"))
root = boxlib.nights_root(os.environ)
night_id = boxlib.new_night_id("task")
d = boxlib.night_dir(root, night_id)
try:
    workdir, argv, secs = boxlib.task_command(home, d, a.get("repo", ""), int(a.get("minutes", 30)))
except (ValueError, TypeError) as exc:
    sys.exit(boxlib.refuse(str(exc)))
d.mkdir(parents=True)
(d / "prompt.txt").write_text(prompt)
try:
    boxlib.start_night("task", workdir, argv, secs, dict(os.environ),
                       {"repo": a["repo"], "minutes": int(a.get("minutes", 30))}, night_id=night_id)
except RuntimeError as exc:
    sys.exit(boxlib.refuse(str(exc)))
print(json.dumps({"id": night_id}))
