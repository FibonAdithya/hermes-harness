#!/usr/bin/env python3
"""Every night on the box: id, status, start time, exit code, doctor summary; and the doctor unit. Ungated."""
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import boxlib  # noqa: E402

boxlib.read_json_stdin(sys.stdin.buffer)  # arguments are ignored; consume stdin
try:
    failed = subprocess.run(["systemctl", "--user", "is-failed", "fleet-doctor.service"],
                            capture_output=True, text=True, check=False).stdout.strip() == "failed"
except OSError:  # no systemctl on this host: nothing can have failed
    failed = False
print(json.dumps({"nights": boxlib.read_status(boxlib.nights_root(os.environ)),
                  "doctor_unit": "failed" if failed else "ok"}))
